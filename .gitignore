# ==============================
# PhishLens X - Git Ignore
# ==============================

# Environment files / secrets
.env
.env.*
!.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
.next/
out/
.vercel/

# Build output
dist/
build/

# Python
__pycache__/
*.py[cod]
*.pyo

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python testing / cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python packages
*.egg-info/

# ML generated/model artifacts
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.onnx

# Generated ML files
models/generated/
backend/models/generated/

# Generated / processed datasets
datasets/generated/
datasets/processed/
backend/datasets/generated/
backend/datasets/processed/

# Logs
*.log
logs/

# IDE
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Docker local data
docker-data/
docker-volumes/

# Coverage / reports
coverage/

# Temporary archives
*.zip
*.tar
*.gz